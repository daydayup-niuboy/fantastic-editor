{
  "name": "fantastic-editor",
  "version": "0.3.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Local-first Markdown editor for Windows",
  "author": {
    "name": "Tbin",
    "email": "niuboy5188@gmail.com"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && npm run dev --workspace @fantastic-editor/desktop",
    "start": "npm run build && npm run start --workspace @fantastic-editor/desktop",
    "build": "npm run build:packages && npm run build --workspace @fantastic-editor/desktop",
    "build:packages": "npm run build --workspace @fantastic-editor/document-core && npm run build --workspace @fantastic-editor/shared",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:signing": "node --test scripts/signing-config.test.mjs",
    "test:watch": "vitest",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "dist:win": "npm run icons:generate && npm run build && node scripts/build-windows.mjs nsis && npm run verify:privacy",
    "dist:portable": "npm run icons:generate && npm run build && node scripts/build-windows.mjs portable && npm run verify:privacy && npm run verify:portable && npm run verify:production",
    "dist:rc": "npm run icons:generate && npm run build && node scripts/build-windows.mjs nsis portable && npm run verify:privacy && npm run verify:release && npm run verify:production && npm run verify:installer",
    "signing:check": "node scripts/signing-preflight.mjs",
    "dist:signed": "npm run signing:check && npm run icons:generate && npm run build && node scripts/build-windows.mjs --signed nsis portable && npm run verify:privacy && npm run verify:signed && npm run verify:production && npm run verify:installer",
    "verify:release": "node scripts/verify-release.mjs --smoke",
    "verify:portable": "node scripts/verify-release.mjs --portable-only --smoke",
    "verify:privacy": "node scripts/verify-release-privacy.mjs",
    "verify:signed": "node scripts/verify-release.mjs --require-signed --smoke",
    "verify:production": "node scripts/verify-production-smokes.mjs",
    "verify:installer": "node scripts/verify-installer.mjs",
    "release:gate": "npm test -- --run && npm run test:signing && npm run typecheck && npm run dist:rc"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "apps/desktop/out/main/index.js",
  "dependencies": {
    "@fantastic-editor/document-core": "file:packages/document-core",
    "@fantastic-editor/shared": "file:packages/shared",
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.7.1",
    "katex": "^0.18.4",
    "mermaid": "^11.17.2"
  },
  "build": {
    "appId": "com.fantastic.editor",
    "productName": "fantastic-editor",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "apps/desktop/out/**/*",
      "packages/document-core/dist/**/*",
      "packages/document-core/package.json",
      "packages/shared/dist/**/*",
      "packages/shared/package.json",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/@types/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/vitest/**/*",
      "!node_modules/@vitest/**/*",
      "!node_modules/vite/**/*",
      "!node_modules/@vitejs/**/*",
      "!node_modules/electron-vite/**/*",
      "!node_modules/esbuild/**/*",
      "!node_modules/@esbuild/**/*",
      "!node_modules/rollup/**/*",
      "!**/wechat-api-config-v1.json",
      "!**/.env*",
      "!**/*.{pfx,p12,pvk,key}"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "fantastic-editor-${version}-setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/nsis-custom.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "fantastic-editor"
    },
    "portable": {
      "artifactName": "fantastic-editor-${version}-portable.${ext}"
    }
  }
}
